+def logrank_cr_score(left, event, parent, cause_weights=None, split_score='signed_sum'):
+    """Default signed combination or opt-in RMS standardized cause score.
+
+    The quadratic alternative is a search criterion, not a chi-square test:
+    cross-cause covariances are not estimated. It changes normalization as well
+    as removing signed cross-cause cancellation. Zero-variance terms contribute
+    zero, with the same numerical variance threshold as the legacy score.
+    """
+    num, var = logrank_cr_components(left, event, parent)
+    w = _cause_weights(cause_weights, len(num))
+    if split_score == 'causewise_quadratic':
+        z2 = np.divide(num * num, var, out=np.zeros_like(var), where=var > 1e-18)
+        w2 = (w / w.max()) ** 2
+        return float(np.sqrt((w2 @ z2) / w2.sum()))
+    if split_score != 'signed_sum':
+        raise ValueError('unknown split score')
     numerator, variance = abs(w @ num), (w ** 2) @ var
     return float(numerator / np.sqrt(variance)) if variance > 1e-18 else 0.
 
 
+def target_support_allows(left, event, groups, target_cause=1, minimum=0):
+    """Allow zero-event children; reject nonzero support below minimum.
+
+    Count DISTINCT companies, not repeated bootstrap rows. This protects
+    positive-event child support without requiring events in both children.
+    """
+    if minimum == 0:
+        return True
+    target = event == target_cause
+    counts = [len(np.unique(groups[side & target])) for side in (left, ~left)]
+    return all(n == 0 or n >= minimum for n in counts)
+
